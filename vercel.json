{
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    { "source": "/veiculos/golf/:path*", "destination": "/veiculo/b192cd89-41e4-4776-8d75-df6ff06dadab", "permanent": true }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "https://sul-veiculos.vercel.app/admin" },
    { "source": "/admin/:path*", "destination": "https://sul-veiculos.vercel.app/admin/:path*" },
    { "source": "/veiculo/:id", "destination": "/veiculo/index.html" }
  ]
}
